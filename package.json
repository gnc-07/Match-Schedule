{
  "name": "matchday-planner-tests",
  "private": true,
  "description": "Local accessibility and quality checks for Matchday Planner (not part of the published site)",
  "type": "module",
  "scripts": {
    "format": "node tests/format.mjs",
    "format:check": "node tests/format.mjs --check",
    "test:py": "python3 -m unittest discover -s tests",
    "test:security": "node tests/security.mjs",
    "test:axe": "node tests/axe.mjs",
    "test:corners": "node tests/corners.mjs",
    "test:layout": "node tests/layout.mjs",
    "test:browsers": "node tests/browsers.mjs",
    "test:lighthouse": "node tests/lighthouse.mjs",
    "test:motion": "node tests/motion-check.mjs",
    "test": "node tests/run.mjs",
    "test:quick": "node tests/run.mjs quick"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.0.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "puppeteer-core": "^23.0.0"
  }
}
